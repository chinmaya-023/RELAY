# Server-only configuration. Never expose or copy these values to the frontend.
PORT=4000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173

# Comma-separated Firebase account emails that may access the Relay owner console.
# Leave empty until the first owner account has been created and verified.
RELAY_ADMIN_EMAILS=

# High-entropy secrets. Generate unique values for every environment.
RELAY_GATEWAY_SIGNING_SECRET=
RELAY_API_KEY_PEPPER=

# Per-process control-plane API protection.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=300

# Firebase Admin. Use application default credentials or provide all values below.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to true only after Firebase's Trigger Email extension is configured to
# watch this Firestore collection. The extension owns SMTP delivery settings.
FIREBASE_TRIGGER_EMAIL_ENABLED=false
FIREBASE_TRIGGER_EMAIL_COLLECTION=relayAlertMail
