{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "relay.rescuevault.in/*",
      "zone_name": "rescuevault.in"
    }
  ]
}