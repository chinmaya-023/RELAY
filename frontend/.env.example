# Public build-time configuration. These values are visible in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Public URLs without trailing slashes.
VITE_API_BASE_URL=http://localhost:4000

# URL used after a Firebase account-management action completes.
# In Firebase Authentication, set the Password reset and Verify email custom
# action URL to https://your-frontend-domain/auth/action. Also configure the
# Firebase password policy itself to require 12–128 characters, so its hosted
# action page cannot accept a longer password.
VITE_AUTH_CONTINUE_URL=http://localhost:5173/login
