# Public build-time configuration. These values are visible in the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Public URLs without trailing slashes.
VITE_API_BASE_URL=http://localhost:4000

# Optional URL used by Firebase account-management emails after their action completes.
VITE_AUTH_CONTINUE_URL=http://localhost:5173/login
